pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application...'
                bat 'cd app\\devsecops-app && mvn clean package -DskipTests'
            }
        }
        stage('Test') {
            steps {
                echo 'Running application tests...'
                bat 'cd app\\devsecops-app && mvn test'
            }
        }
        stage('SonarQube Analysis') {
            steps {
                echo 'Running SonarQube code analysis...'
                withSonarQubeEnv('SonarQube') {
                bat 'cd app\\devsecops-app && mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=Enterprise-DevSecOps-CI-CD
        }
    }
}

    }
}